# Copy to .env and fill in. Only the key for your chosen LLM_PROVIDER is required.
#   Copy-Item .env.example .env

# ---------------------------------------------------------------------------
# LLM
# ---------------------------------------------------------------------------
# groq | anthropic
LLM_PROVIDER=groq

# Required when LLM_PROVIDER=groq
GROQ_API_KEY=
# Leave blank to auto-resolve a current tool-calling model from the live Groq
# model catalogue at startup. Set it to pin a specific model id.
GROQ_MODEL=

# Required when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Destination
# ---------------------------------------------------------------------------
DESTINATION=Singapore
DESTINATION_CURRENCY=SGD
HOME_CURRENCY=INR

# ---------------------------------------------------------------------------
# Retrieval
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RETRIEVAL_K=6
# Cosine-similarity floor for the knowledge base. Below it the KB tool returns
# NO_RELEVANT_CONTENT and the assistant says so instead of inventing facts.
# Calibrated on this corpus: real travel questions score 0.62-0.86, unrelated
# questions 0.49-0.63. Range 0.0-1.0.
RELEVANCE_FLOOR=0.60
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# ---------------------------------------------------------------------------
# Ingestion UI (/admin)
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=20

# ---------------------------------------------------------------------------
# Optional: LangSmith tracing
# ---------------------------------------------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=northstar-travel-assistant
